PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/scott_portfolio
CLIENT_ORIGIN=http://localhost:5173
INQUIRY_TO_EMAIL=you@example.com
INQUIRY_FROM_NAME=Portfolio Website

# SMTP settings required for inquiry email delivery
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# INQUIRY_FROM_EMAIL=your-email@gmail.com

# Optional fallback (recommended for local dev).
# In production, inquiries return 503 unless you enable this explicitly.
# ALLOW_INQUIRY_FALLBACK=true
# INQUIRY_FALLBACK_FILE=C:\temp\portfolio-inquiries.jsonl
